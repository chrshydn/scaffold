{
  "name": "scaffold-structure-map",
  "displayName": "Scaffold - Structure Map",
  "description": "Live structural map of React/React Native TypeScript codebases",
  "version": "0.2.0",
  "publisher": "chrshydn",
  "icon": "media/scaffold-icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrshydn/scaffold"
  },
  "bugs": {
    "url": "https://github.com/chrshydn/scaffold/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "react",
    "react-native",
    "typescript",
    "codebase",
    "structure",
    "imports",
    "dependencies"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "scaffold",
          "title": "Scaffold",
          "icon": "media/scaffold-icon.svg"
        }
      ]
    },
    "views": {
      "scaffold": [
        {
          "type": "webview",
          "id": "scaffold.structureView",
          "name": "Structure Map",
          "icon": "media/scaffold-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "scaffold.refresh",
        "title": "Scaffold: Refresh Structure Map",
        "icon": "$(refresh)"
      },
      {
        "command": "scaffold.showFileMetrics",
        "title": "Scaffold: Show File Metrics",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "scaffold.refresh",
          "when": "view == scaffold.structureView",
          "group": "navigation",
          "icon": "$(refresh)"
        }
      ],
      "explorer/context": [
        {
          "command": "scaffold.showFileMetrics",
          "when": "resourceExtname == .ts || resourceExtname == .tsx",
          "group": "scaffold"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test --ext ts",
    "bundle": "npm run typecheck && esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --format=cjs --platform=node --target=node18 --minify",
    "typecheck": "tsc -p ./ --noEmit",
    "pretest": "npm run bundle && tsc -p tsconfig.test.json",
    "test": "npm run test:webview && npm run test:integration",
    "test:webview": "mocha out-test/test/webview.test.js",
    "test:integration": "node out-test/test/runTest.js"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.25.12",
    "eslint": "^8.54.0",
    "jsdom": "^26.1.0",
    "mocha": "^11.8.0",
    "typescript": "^5.3.0"
  }
}
